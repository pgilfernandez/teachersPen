{
  "name": "teacherspen",
  "productName": "TeachersPen",
  "version": "1.0.0",
  "private": true,
  "description": "Anotaciones sobre el escritorio para profesores",
  "author": "Pablo Gil Fern\u00e1ndez",
  "homepage": "https://github.com/pgilfernandez/teachersPen",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "build": "node scripts/build-light.mjs",
    "start": "npm run pack && node scripts/run-light.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "pack": "node scripts/pack-light.mjs",
    "dist:mac": "node scripts/dist-mac-light.mjs",
    "dist:win": "tauri build --bundles nsis",
    "dist:linux": "tauri build --bundles appimage,deb",
    "check": "npm run typecheck && npm test",
    "build:gnome": "node scripts/build-gnome.mjs",
    "install:gnome": "node scripts/install-gnome.mjs",
    "test:gnome": "node scripts/test-gnome.mjs",
    "licenses:check": "node scripts/check-licenses.mjs",
    "licenses:verify": "node scripts/verify-licenses.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tauri-apps/api": "1.6.0",
    "@tauri-apps/cli": "1.6.3",
    "@types/node": "20.19.9",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "dialog-polyfill": "0.5.6",
    "esbuild": "0.25.5",
    "lucide-react": "1.66.0",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
