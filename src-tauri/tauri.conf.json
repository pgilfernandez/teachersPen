{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both"
      }
    },
    "category": "Education",
    "shortDescription": "Live screen annotations for teaching",
    "copyright": "Copyright 2026 Pablo Gil Fern\u00e1ndez",
    "icon": [
      "../dist/icons/app.icns",
      "../dist/icons/app.ico",
      "../dist/icons/app-256.png"
    ],
    "externalBin": [
      "binaries/key-state"
    ],
    "resources": [
      "../LICENSE.md",
      "../NOTICE.md",
      "../src/renderer/assets/icons/LICENSE-lucide.txt",
      "../dist-light/THIRD-PARTY-NOTICES.txt",
      "../dist-light/THIRD-PARTY-LICENSES.json",
      "../dist-light/THIRD-PARTY-SOURCES.tar.gz"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libx11-6"
        ]
      }
    }
  },
  "build": {
    "beforeBuildCommand": "node scripts/build-light.mjs",
    "beforeDevCommand": "node scripts/build-light.mjs",
    "frontendDist": "../dist-light",
    "windows": {
      "staticVCRuntime": true
    }
  },
  "productName": "TeachersPen",
  "mainBinaryName": "teachers-pen",
  "version": "../package.json",
  "identifier": "org.teacherspen.desktop",
  "plugins": {},
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  }
}
