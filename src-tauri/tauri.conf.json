{
  "$schema": "https://schema.tauri.app/config/1",
  "package": {
    "productName": "TeachersPen",
    "version": "../package.json"
  },
  "build": {
    "beforeBuildCommand": "node scripts/build-light.mjs",
    "beforeDevCommand": "node scripts/build-light.mjs",
    "devPath": "../dist-light",
    "distDir": "../dist-light",
    "withGlobalTauri": false
  },
  "tauri": {
    "windows": [],
    "macOSPrivateApi": true,
    "allowlist": {
      "all": false
    },
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: https://asset.localhost; connect-src ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'"
    },
    "bundle": {
      "active": true,
      "identifier": "org.teacherspen.desktop",
      "category": "Education",
      "shortDescription": "Live screen annotations for teaching",
      "copyright": "Copyright 2026 Pablo Gil Fern\u00e1ndez",
      "icon": [
        "../dist/icons/app.icns",
        "../dist/icons/app.ico",
        "../dist/icons/app-256.png"
      ],
      "externalBin": [
        "binaries/key-state"
      ],
      "resources": [
        "../LICENSE.md",
        "../NOTICE.md",
        "../src/renderer/assets/icons/LICENSE-lucide.txt",
        "../dist-light/THIRD-PARTY-NOTICES.txt"
      ],
      "macOS": {
        "minimumSystemVersion": "11.0"
      },
      "windows": {
        "webviewInstallMode": {
          "type": "downloadBootstrapper",
          "silent": true
        },
        "nsis": {
          "installMode": "currentUser"
        }
      },
      "deb": {
        "depends": [
          "libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "libx11-6"
        ]
      }
    },
    "systemTray": {
      "iconPath": "../dist/icons/trayTemplate.png",
      "iconAsTemplate": true
    }
  }
}
